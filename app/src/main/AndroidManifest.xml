<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <queries>
        <package android:name="com.cusc.voiceassistant" />
        <package android:name="com.tencent.qqmusiccar" />
    </queries>
    <application android:label="PSA音乐助手" android:icon="@android:drawable/ic_btn_speak_now"
        android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".TriggerActivity" android:theme="@style/AssistantTrigger"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 语音聊天入口：无 LAUNCHER 过滤器（避免桌面出现第二个图标），由工具箱按组件名拉起 -->
        <activity android:name=".ChatTriggerActivity" android:theme="@style/AssistantTrigger"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" android:exported="true" />
        <service android:name=".AssistantService" android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <service android:name=".MediaAccessService" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
